# Copy to .env (gitignored) and load with:  set -a; . ./.env; set +a
#
# Points the integration test lane and the getting-started Livebook at a
# running Apache AGE server. The quickest local server:
#
#   docker compose up -d        # apache/age on localhost:5462 (compose.yaml)
#
# With this set, `mix test` runs unit + integration; with it unset (or via
# `mix test.unit`), only the no-database unit lane runs.
AGE_DATABASE_URL=postgres://postgres:postgres@localhost:5462/ash_age_test
